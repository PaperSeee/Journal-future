# ─────────────────────────────────────────────────────────────
# HqGambler — environment variables
# Copy to `.env.local` for dev, set the same in Vercel for prod.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# PRODUCTION (Neon Postgres): create a project at https://neon.tech
# and paste the pooled connection string. Must end with ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# LOCAL DEV fallback (SQLite) — uncomment these two lines and comment out
# the Postgres URL above, then set provider="sqlite" in prisma/schema.prisma
# (see README "Dev local SQLite"). The default schema targets Postgres.
# DATABASE_URL="file:./prisma/dev.db"

# ── Auth (NextAuth credentials, single user) ──────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# The one and only account that can log in.
APP_USER_EMAIL="you@example.com"
# bcrypt hash of your password. Generate with:  npm run hash -- "yourPassword"
# (or use the snippet in the README). Falls back to APP_USER_PASSWORD if unset.
APP_USER_PASSWORD_HASH=""
# Plain password fallback (dev only — prefer the hash above in production).
APP_USER_PASSWORD="changeme"
